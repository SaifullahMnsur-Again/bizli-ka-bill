{
  "metadata": {
    "title": "Bangladesh Electricity Tariff Rates & Web-App Billing Engine",
    "description": "Scalable JSON representation of electricity billing rules designed for static web applications. Formulae are written in valid JavaScript expressions for direct extraction and evaluation. Includes data sources, tension definitions, and effective dates.",
    "source_repository": "https://dpdc.gov.bd/pages/static-pages/6922de6f933eb65569e1a9c4",
    "tension_categories": {
      "LT": "Light Tension",
      "MT": "Medium Tension",
      "HT": "High Tension",
      "EHT": "Extreme High Tension"
    },
    "schema_legend": {
      "dc": "Demand Charge (Tk/kW/month)",
      "energy": {
        "t": "Tariff Type (slab, flat, tou)",
        "ll": "Lifeline (0-50 units) rate",
        "s1": "Step 1 (0-75 units) rate",
        "s2": "Step 2 (76-200 units) rate",
        "s3": "Step 3 (201-300 units) rate",
        "s4": "Step 4 (301-400 units) rate",
        "s5": "Step 5 (401-600 units) rate",
        "s6": "Step 6 (Above 600 units) rate",
        "f": "Flat Rate",
        "o": "Off-Peak Rate",
        "so": "Super Off-Peak Rate",
        "p": "Peak Rate"
      }
    }
  },
  "web_app_integration_guide": {
    "expected_user_inputs": [
      "total_units", "peak_units", "off_peak_units", "super_off_peak_units", "flat_units", "approved_load_kw", "actual_max_demand_kw", "pf"
    ],
    "context_variables": [
      "rates (Extracted from the selected customer category)",
      "parameters (Extracted from the selected gazette release)"
    ],
    "execution_flow": "1. Fetch 'rates' and 'parameters'. 2. Evaluate 'energy_charge' matching the category's tariff type. 3. Evaluate 'demand_charge'. 4. Evaluate 'surcharges_and_penalties'. 5. Evaluate 'net_bill'. 6. Evaluate 'gross_bill' based on meter type."
  },
  "extractable_formulae": {
    "energy_charge": {
      "slab": "total_units <= 50 ? (total_units * rates.ll) : ((Math.min(total_units, 75) * rates.s1) + (Math.max(0, Math.min(total_units - 75, 125)) * rates.s2) + (Math.max(0, Math.min(total_units - 200, 100)) * rates.s3) + (Math.max(0, Math.min(total_units - 300, 100)) * rates.s4) + (Math.max(0, Math.min(total_units - 400, 200)) * rates.s5) + (Math.max(0, total_units - 600) * rates.s6))",
      "flat": "total_units * rates.f",
      "tou": "((peak_units || 0) * rates.p) + ((off_peak_units || 0) * rates.o) + ((super_off_peak_units || 0) * (rates.so || 0)) + ((flat_units || 0) * (rates.f || 0))"
    },
    "demand_charge": {
      "lt_mt": "approved_load_kw * rates.dc",
      "ht_eht": "Math.max(actual_max_demand_kw, approved_load_kw * parameters.ht_eht_minimum_dc_percentage) * rates.dc"
    },
    "surcharges_and_penalties": {
      "excess_load_penalty": "actual_max_demand_kw > approved_load_kw ? (actual_max_demand_kw - approved_load_kw) * (rates.dc * parameters.excess_load_penalty_multiplier) : 0",
      "power_factor_surcharge": "(pf < parameters.power_factor_minimum && pf >= 0.75) ? ec * (((parameters.power_factor_minimum - pf) / 0.01) * parameters.power_factor_surcharge_per_0_01_drop) : 0"
    },
    "final_bill": {
      "net_bill": "ec + base_dc + penalty_dc + pf_surcharge",
      "gross_bill_prepaid": "(net_bill - (net_bill * parameters.prepaid_rebate_percentage)) * (1 + parameters.vat_percentage)",
      "gross_bill_postpaid_on_time": "net_bill * (1 + parameters.vat_percentage)",
      "gross_bill_postpaid_late": "net_bill * (1 + parameters.vat_percentage) + (net_bill * parameters.late_payment_surcharge_percentage)"
    }
  },
